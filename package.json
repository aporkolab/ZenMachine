{
  "name": "zenmachine",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration client-only",
    "build:prod": "ng build --configuration production",
    "build:ssr": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --watch=false --code-coverage",
    "test:unit:watch": "ng test --watch=true",
    "test:integration": "jest --config jest.integration.config.js",
    "test:e2e": "npx playwright test",
    "e2e:headless": "npx playwright test",
    "test:coverage": "ng test --code-coverage --watch=false",
    "test:smoke": "jest --config jest.smoke.config.js",
    "test:load": "k6 run tests/load/load-test.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "prettier": "prettier --write \"src/**/*.{ts,js,html,scss,css,json}\"",
    "prettier:check": "prettier --check \"src/**/*.{ts,js,html,scss,css,json}\"",
    "type-check": "tsc --noEmit",
    "analyze": "ng build --configuration client-only --stats-json",
    "prepare": "husky install",
    "serve:ssr:zenmachine": "node dist/zenmachine/server/server.mjs",
    "test:dependency-guards": "node --test vendor/braces/test.cjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,scss,css}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.33",
    "@angular/cdk": "^20.2.1",
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/forms": "20.3.33",
    "@angular/material": "^20.2.1",
    "@angular/platform-browser": "20.3.33",
    "@angular/platform-server": "20.3.33",
    "@angular/router": "20.3.33",
    "@angular/ssr": "20.3.39",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.2.0",
    "@angular-eslint/eslint-plugin": "20.2.0",
    "@angular-eslint/eslint-plugin-template": "20.2.0",
    "@angular-eslint/schematics": "20.2.0",
    "@angular-eslint/template-parser": "20.2.0",
    "@angular/build": "20.3.39",
    "@angular/cli": "20.3.39",
    "@angular/compiler-cli": "20.3.33",
    "@angular/platform-browser-dynamic": "20.3.33",
    "@playwright/test": "^1.40.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.17.19",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "audit-ci": "^6.6.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jasmine-core": "~5.9.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "serve": "^14.2.5",
    "ts-jest": "^29.1.0",
    "typescript": "~5.9.2",
    "webpack-bundle-analyzer": "^4.9.0",
    "braces": "file:vendor/braces"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "overrides": {
    "braces": "$braces",
    "picomatch@>=4 <5": "^4.0.4",
    "compression": "^1.8.2"
  }
}
